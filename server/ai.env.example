# Copy to .env.ai.local at the repository root. Never use a VITE_ prefix for this key.
OPENAI_API_KEY=
# Keep false for the scripted preview and all offline checks.
AI_PRACTICE_LIVE_ENABLED=false
AI_PRACTICE_MODEL=gpt-6.1-sol
AI_TRANSCRIPTION_MODEL=gpt-transcribe
# Hosted and signed-in local usage uses ai_service_limits in the database.
# This setting only caps an isolated service without a hosted attempt store.
AI_PRACTICE_MAX_CALLS_PER_HOUR=120
AI_PRACTICE_PORT=5555
AI_PRACTICE_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174
